{
  "name": "dsh-media-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Right-sidebar media tab for DeepSeek Harness: inline playback for local audio/video — HTTP Range for native formats, ffmpeg transcoding for mkv/avi/flv/wmv.",
  "license": "MIT",
  "author": "guwenwu112233-dot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guwenwu112233-dot/dsh-media-sideba.git"
  },
  "homepage": "https://github.com/guwenwu112233-dot/dsh-media-sideba#readme",
  "bugs": {
    "url": "https://github.com/guwenwu112233-dot/dsh-media-sideba/issues"
  },
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "right-sidebar",
    "audio",
    "video",
    "media",
    "http-range",
    "ffmpeg",
    "transcode"
  ]
}
